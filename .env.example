# ==============================================================================
# TribalScholar AI (ADIVYA) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to version control.

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
# Async URL for FastAPI backend with SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://tribalscholar:tribalscholar@localhost:5432/tribalscholar_db

# Sync URL for Alembic migrations and CLI scripts with psycopg2
DATABASE_URL_SYNC=postgresql://tribalscholar:tribalscholar@localhost:5432/tribalscholar_db

# Security & Authentication (JWT / Sessions)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage (local filesystem path for uploaded verification documents)
FILE_STORAGE_PATH=./uploads

# Document-AI Module Integration
DOCUMENT_AI_LOG_LEVEL=INFO
